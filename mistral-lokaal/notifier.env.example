# Kopieer lokaal naar secure/notifier.env. De map secure/ staat in .gitignore.
# Vul echte waarden uitsluitend in die lokale kopie in.

NOTIFIER_CHANNELS=email
NOTIFIER_ACTION_URL=https://github.com/BSandman/ALV_Digitaal/actions

SMTP_HOST=smtp.provider.invalid
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=lokaal-gebruikersnaam
SMTP_PASSWORD=lokaal-wachtwoord
SMTP_FROM=afzender
SMTP_TO=ontvanger

# Optionele push via ntfy: zet NOTIFIER_CHANNELS=email,ntfy en vul dit lokaal in.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=lokaal-uniek-topic
# NTFY_TOKEN=lokaal-token
