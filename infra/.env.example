# Kopieer naar .env en pas aan. .env staat in .gitignore en gaat NOOIT mee in Git,
# prompts, screenshots of release-zips (voorstel §2.2, AVG-regels).
# Dit zijn DEV-defaults met fictieve waarden — geen productiegeheimen.

NODE_ENV=development

# Database (dev). Productiegeheimen leven NIET hier maar op .starter
# (DirectAdmin-env of configbestand buiten webroot — te bevestigen, voorstel §8 punt 5).
DB_NAME=alv
DB_USER=alv
DB_PASSWORD=alv_dev_pw
DB_ROOT_PASSWORD=root_dev_pw

# App
TRUST_PROXY=1
APP_SINGLE_PROCESS=true
AUTH_PEPPER=synthetic-dev-pepper-change-before-acceptance
