# Kopieer de waarden handmatig naar /home/cn111993/secrets/alv-acceptatie.env.
# Het echte bestand: chmod 600, buiten application root/webroot, nooit in Git.
DEPLOY_TARGET=acceptatie
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cn111993_acceptatie
DB_USER=cn111993_acceptatie
DB_PASSWORD=
DB_POOL_SIZE=5
DB_SESSION_SQL_MODE=STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,NO_BACKSLASH_ESCAPES
AUTH_PEPPER=
TRUST_PROXY=1

