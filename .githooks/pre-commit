#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$repo_root/scripts/lint_handoff.py" "$repo_root/handoff.md"
elif command -v python >/dev/null 2>&1; then
  exec python "$repo_root/scripts/lint_handoff.py" "$repo_root/handoff.md"
elif command -v py >/dev/null 2>&1; then
  exec py -3 "$repo_root/scripts/lint_handoff.py" "$repo_root/handoff.md"
fi

echo "Handoff-gate: ROOD — Python 3 is niet beschikbaar." >&2
exit 1
